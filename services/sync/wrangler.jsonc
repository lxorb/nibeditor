{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nib-sync",
  "main": "src/machines/entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nib",
      "database_id": "3eb83f94-5361-4850-a256-28611a4f94a4",
      "migrations_dir": "migrations",
    },
  ],

  // One Durable Object per file that is being edited together: the room holds
  // the CRDT state, the sockets and the awareness, and writes the settled file
  // back into the note store. SQLite-backed, which is what a new class must be.
  //
  // One class for both kinds of room. A note holds its words as a Y.Text and a
  // canvas holds the objects on it as a map by id, and that difference is one
  // module in the Worker (rooms/kind.ts) rather than a second class: a room is
  // named by the file's id either way, so there is already one instance per
  // file, and a second class would mean a second migration tag for the sake of
  // one seed and one serialiser. No tag is added here for canvases, which is
  // the point.
  //
  // And one per account, the hub: every signed-in device keeps one socket to it,
  // which carries the pokes that say a space moved, the leases on web logins, and
  // the web key's relay between computers. Named by the account id (or a guest's),
  // hibernating, SQLite-backed for the same reason as the rooms; see
  // src/hub/hub.ts and docs/sync-v2.md section 6.2. A tag of its own, because a
  // migration tag is applied once and never changed.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "NoteRoom" },
      { "name": "HUB", "class_name": "AccountHub" },
      // One per online terminal machine, named by its id, in the EU (decision 6).
      { "name": "MACHINES", "class_name": "Machine" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountHub"] },
    { "tag": "v3", "new_sqlite_classes": ["Machine"] },
  ],

  // The machines' container application. `durable_object` scheduling: each `Machine`
  // starts its own instance with `ctx.container.start()`, choosing the image (or the
  // snapshot to boot from) and the instance size there; see machines/host.ts. The image
  // is services/machine/Dockerfile (Ubuntu 24.04, nibd, the tools; 4.2), built and
  // pushed to Cloudflare's registry by `wrangler deploy`.
  "containers": [
    {
      "class_name": "Machine",
      "name": "nib-sync-machines",
      "scheduling_policy": "durable_object",
      "images": { "machine": { "dockerfile": "../machine/Dockerfile" } },
    },
  ],

  "r2_buckets": [
    { "binding": "NOTES", "bucket_name": "nib-notes" },
    // The machines' homes, backed up as they sleep (4.3), kept in the EU.
    { "binding": "HOMES", "bucket_name": "nib-homes", "jurisdiction": "eu" },
  ],

  // Workers AI. What listens for an account with no OpenAI key of its own: the
  // glasses hand a plugin raw PCM and nothing on the device turns it into words, so
  // `POST /v1/ask/heard` runs Whisper here instead. Nothing to set up beyond this
  // line; there is a free daily allowance and it is billed per neuron past it, and a
  // spoken command is a second or two of audio. See src/ask/heard.ts.
  "ai": { "binding": "AI" },

  // The built web app. The Worker runs first so a published blog's hostname
  // still wins over the editor - but not for the bundle itself. Hashed assets
  // are the same bytes for everyone and no blog ever asks for them, so they
  // are served straight from the edge instead of billing a Worker invocation
  // each. That is most of the requests a page load makes.
  "assets": {
    "directory": "../../apps/desktop/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },

  // Cloudflare Email Sending, which is what signs everybody in. It needs
  // `nibeditor.com` onboarded under Email Service > Email Sending (that adds
  // the cf-bounce MX, SPF and DKIM records and `_dmarc`) on top of Workers
  // Paid. Without it this binding is Email Routing's and reaches only the
  // account's verified addresses; see `cloudflare` in src/email.ts.
  "send_email": [{ "name": "EMAIL" }],

  // Domains people bring are served through Cloudflare for SaaS: the owner
  // CNAMEs their domain to BLOG_CNAME_TARGET, and the Worker asks the zone for
  // a "custom hostname" so the edge has a certificate to answer with. Nothing is
  // asked for until the domain has been shown to be theirs by a TXT record at
  // `_nib-verify.<domain>`; see src/spaces/proof.ts. That needs, once, in the
  // dashboard for nibeditor.com:
  //   1. SSL/TLS > Custom Hostnames: enable Cloudflare for SaaS (a payment
  //      method is asked for; the first hundred hostnames are free).
  //   2. A proxied DNS record for the target, with nothing behind it:
  //      cname.nibeditor.com  AAAA  100::
  //   3. Set that name as the fallback origin on the same page.
  //   4. `wrangler secret put CF_API_TOKEN`: a token with "Zone > SSL and
  //      Certificates > Edit" on nibeditor.com and nothing else.
  // CF_ZONE_ID is the zone's id, and not a secret. Without both, a domain is
  // recorded and no certificate is asked for; the status endpoint says so.
  //
  // A domain whose zone is in this same Cloudflare account needs none of
  // that: a proxied CNAME to the target in its own zone plus a Worker route
  // `<host>/*` -> nib-sync added there serves it under that zone's own
  // certificate (blog.emilvinu.ch is set up this way). The status endpoint
  // cannot see such a route and reports the domain as unconfigured or
  // pending even while it serves; that is a known blind spot, not a fault.
  // The account's OpenAI key is stored encrypted, under a key derived from a
  // secret that lives here and nowhere in this repository. Set it once, with
  // anything long and random:
  //   wrangler secret put OPENAI_KEY_SECRET
  // Without it the Worker refuses to store a key rather than storing one in the
  // clear, and the settings pane says the server cannot keep one yet. Changing it
  // makes every key already stored unreadable, and every reader has to paste
  // theirs again; there is no way to read one out and re-encrypt it, which is the
  // point. See src/ask/key.ts and docs/even.md.
  //
  // The second factor's authenticator secrets are kept under a secret of their
  // own, so that rotating the one above locks nobody out:
  //   wrangler secret put SECOND_FACTOR_SECRET
  // Until it is set they are sealed under OPENAI_KEY_SECRET as before; once it is,
  // each moves across on its next good code and on the next nightly run, and after
  // that night OPENAI_KEY_SECRET can be rotated freely. See src/second.ts.
  "vars": {
    "BLOG_ROOT": "nibeditor.com",
    "BLOG_CNAME_TARGET": "cname.nibeditor.com",
    "CF_ZONE_ID": "46c1a42759c6af60043e590f581544c0",
    "APP_ORIGIN": "https://nibeditor.com",
    "MAIL_FROM": "nibeditor <nib@nibeditor.com>",
    // How a machine's traffic leaves it: `open` or `web`; see machines/host.ts.
    "MACHINE_EGRESS": "open",
    // The account the Hetzner machines' Cloudflare Tunnels are made in (4.15). Their
    // secrets, set by hand, never here (docs/online-terminal-live.md):
    //   wrangler secret put HETZNER_TOKEN           the Hetzner Cloud project's, read and write
    //   wrangler secret put MACHINE_TUNNEL_TOKEN    Cloudflare Tunnel Edit + this zone's DNS Edit
    //   wrangler secret put MACHINE_ACCESS_ID       the Access service token's id and secret,
    //   wrangler secret put MACHINE_ACCESS_SECRET   which the link to a machine is sent with
    //   wrangler secret put MACHINE_ACCESS_TEAM     the Access team name and the application's
    //   wrangler secret put MACHINE_ACCESS_AUD      audience tag, which cloudflared checks
    // Without the first two, a Hetzner machine is refused a start as `off`.
    "CF_ACCOUNT_ID": "b0e98c15b1f905a394ecd6a849e8e99f",
  },

  // The catch-all is what lets a custom hostname reach the Worker: a request
  // for notes.example.org enters this zone through its CNAME, and matches
  // neither of the named patterns. The two stay as documentation of what the
  // zone itself answers on.
  // A third route, "*/*", is what lets the Worker answer for custom hostnames
  // (Cloudflare for SaaS). The routes API refuses a wildcard host until SaaS is
  // enabled on the zone (error 10022), so it is added back once that is done.
  // Once a day, everything that has run out of time: Recently deleted is emptied,
  // guests nobody let in and requests nobody answered go, a client that
  // registered and never came back goes, and the record proving each domain of
  // somebody's own is read again. See `scheduled` in src/index.ts, which names
  // the five.
  //
  // And each minute, the reminders due by now pushed to the devices that asked for them;
  // see push/reminders.ts. Push needs keys that are secrets of their own, each service off
  // until its keys are set (docs/mobile.md, "Push"):
  //   VAPID_PUBLIC_KEY      a var below once made; the browser build subscribes with it
  //   wrangler secret put VAPID_PRIVATE_KEY
  //   wrangler secret put FCM_SERVICE_ACCOUNT     the Firebase service account's JSON key
  //   wrangler secret put APNS_KEY                the .p8, with APNS_KEY_ID, APNS_TEAM_ID
  //                                               and APNS_TOPIC as vars
  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "routes": [
    { "pattern": "nibeditor.com/*", "zone_name": "nibeditor.com" },
    { "pattern": "*.nibeditor.com/*", "zone_name": "nibeditor.com" },
    // A custom domain whose zone is in this Cloudflare account needs no SaaS:
    // a proxied record plus a route here. Routes not listed are removed on
    // every deploy, so the shortcut has to live in this file.
    { "pattern": "blog.emilvinu.ch/*", "zone_name": "emilvinu.ch" },
  ],
}
