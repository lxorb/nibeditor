# Maintainer: Emil Vinu <101118850+lxorb@users.noreply.github.com>

# Nib ships an official .deb for both architectures, so this package unpacks
# that rather than rebuilding the app: no Rust or Node toolchain is pulled in
# to install an editor. What comes out of the .deb is repaired on the way in -
# Tauri's own .desktop entry carries no categories, no web handlers and no
# comment, and its 256x256 icon is filed under a scale-2 directory.

pkgname=nib-bin
_pkgname=nib
pkgver=0.8.0
pkgrel=1
pkgdesc="Lightweight markdown editor with realtime inline preview"
arch=('x86_64' 'aarch64')
url="https://nibeditor.com"
license=('AGPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1' 'hicolor-icon-theme')
optdepends=('pandoc: import and export DOCX, ODT, EPUB, LaTeX and friends'
            'xdg-utils: open links and attachments in the desktop default application')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
options=('!strip' '!debug' '!emptydirs')

_url="https://github.com/lxorb/nibeditor/releases/download/v${pkgver}"
source=('nib.desktop')
# One name for both, since only the running architecture is fetched.
source_x86_64=("nib.deb::${_url}/Nib-${pkgver}-linux-x64.deb")
source_aarch64=("nib.deb::${_url}/Nib-${pkgver}-linux-arm64.deb")
noextract=('nib.deb')
sha256sums=('1e3a357024c158d5f7b76dac11ac55c9df15a26d3753da44c603b881be462dcc')
sha256sums_x86_64=('4284fede6d9e6aad8d5a6c398c360517f18a9fa78a9a66fa0ebe0b6e0884c8da')
sha256sums_aarch64=('828e659ca983c8ba91c339f1afddf646c76e9a62d0a92db95c0ebd674eccf8b3')

package() {
  bsdtar -O -xf "${srcdir}/nib.deb" data.tar.gz |
    bsdtar -xf - -C "${pkgdir}" usr

  install -Dm644 "${srcdir}/nib.desktop" \
    "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
  rm -f "${pkgdir}/usr/share/applications/Nib.desktop"

  # The file in 256x256@2 is a plain 256x256 image, so it belongs in the
  # unscaled directory; left where it is, every theme lookup scales it wrong.
  install -Dm644 "${pkgdir}/usr/share/icons/hicolor/256x256@2/apps/${_pkgname}.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${_pkgname}.png"
  rm -rf "${pkgdir}/usr/share/icons/hicolor/256x256@2"
}

# AGPL-3.0-only lives in /usr/share/licenses/common/AGPL3, so no copy is shipped.
