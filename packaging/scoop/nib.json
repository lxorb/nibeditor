{
    "version": "0.13.1",
    "description": "Orden, formerly nibeditor: a simple, lightweight markdown editor offering all the features you could ever need.",
    "homepage": "https://orden.so",
    "license": "AGPL-3.0-only",
    "notes": "Themes and note history live in '%APPDATA%\\ch.emilvinu.nib', which is junctioned into Scoop's persist directory, so they survive updates and uninstalls.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lxorb/orden/releases/download/v0.13.1/Nib-0.13.1-windows-x64-setup.exe#/dl.7z",
            "hash": "5e99b62a419ce1bb911e4db8187f1b3a8e2eb24501132554a7eb49b1670de9c4"
        },
        "arm64": {
            "url": "https://github.com/lxorb/orden/releases/download/v0.13.1/Nib-0.13.1-windows-arm64-setup.exe#/dl.7z",
            "hash": "f6c3404d750d9d0252f6819181cdf6099c208674520a1cd3d1ba8cdea3a6cee7"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction 'Ignore'",
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$appdata = \"$env:APPDATA\\ch.emilvinu.nib\"",
            "if (Test-Path $appdata) {",
            "    if ((Get-Item -LiteralPath $appdata -Force).LinkType -eq 'Junction') {",
            "        Remove-Item -LiteralPath $appdata -Force",
            "    } else {",
            "        Get-ChildItem -LiteralPath $appdata -Force | Move-Item -Destination \"$persist_dir\" -Force",
            "        Remove-Item -LiteralPath $appdata -Recurse -Force",
            "    }",
            "}",
            "New-Item -Path $appdata -ItemType Junction -Target \"$persist_dir\" | Out-Null"
        ]
    },
    "bin": "nib.exe",
    "shortcuts": [
        [
            "nib.exe",
            "Orden"
        ]
    ],
    "uninstaller": {
        "script": "Remove-Item \"$env:APPDATA\\ch.emilvinu.nib\" -Force -Recurse -ErrorAction 'Ignore'"
    },
    "checkver": {
        "github": "https://github.com/lxorb/orden"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lxorb/orden/releases/download/v$version/Orden-$version-windows-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/lxorb/orden/releases/download/v$version/Orden-$version-windows-arm64-setup.exe#/dl.7z"
            }
        }
    }
}
