{
    "version": "0.15.0",
    "description": "Orden, formerly nibeditor: a simple, lightweight markdown editor offering all the features you could ever need.",
    "homepage": "https://orden.so",
    "license": "AGPL-3.0-only",
    "notes": "Themes and note history live in '%APPDATA%\\ch.emilvinu.nib', which is junctioned into Scoop's persist directory, so they survive updates and uninstalls.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lxorb/orden/releases/download/v0.15.0/Orden-0.15.0-windows-x64-setup.exe#/dl.7z",
            "hash": "e6d3d483df42f1e8b9f44dcc9f9109c39b03bfc094702de2066312005c4d9463"
        },
        "arm64": {
            "url": "https://github.com/lxorb/orden/releases/download/v0.15.0/Orden-0.15.0-windows-arm64-setup.exe#/dl.7z",
            "hash": "aadf2f8d21ade842b36f5581b1010b7bd480369586b00f4a3d8be77964332da6"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction 'Ignore'",
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "# Up to 0.15.0 this package was nib, whose persist folder is this one's sibling: what it kept comes over once, while this one holds nothing.",
            "$was = Join-Path (Split-Path $persist_dir) 'nib'",
            "if ((Test-Path $was) -and !(Get-ChildItem -LiteralPath $persist_dir -Force)) {",
            "    Get-ChildItem -LiteralPath $was -Force | Move-Item -Destination \"$persist_dir\" -Force",
            "}",
            "$appdata = \"$env:APPDATA\\ch.emilvinu.nib\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item -LiteralPath $appdata -Force",
            "    if ($item.LinkType -eq 'Junction') {",
            "        # The link alone: Windows PowerShell's Remove-Item follows a junction into what it points at.",
            "        $item.Delete()",
            "    } else {",
            "        Get-ChildItem -LiteralPath $appdata -Force | Move-Item -Destination \"$persist_dir\" -Force",
            "        Remove-Item -LiteralPath $appdata -Recurse -Force",
            "    }",
            "}",
            "New-Item -Path $appdata -ItemType Junction -Target \"$persist_dir\" | Out-Null"
        ]
    },
    "bin": "nib.exe",
    "shortcuts": [
        [
            "nib.exe",
            "Orden"
        ]
    ],
    "uninstaller": {
        "script": [
            "$appdata = Get-Item -LiteralPath \"$env:APPDATA\\ch.emilvinu.nib\" -Force -ErrorAction 'Ignore'",
            "# The link alone, so what it points at - the persist folder, kept until --purge - stays.",
            "if ($appdata.LinkType -eq 'Junction') { $appdata.Delete() } elseif ($appdata) { Remove-Item -LiteralPath $appdata.FullName -Force -Recurse }"
        ]
    },
    "checkver": {
        "github": "https://github.com/lxorb/orden"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lxorb/orden/releases/download/v$version/Orden-$version-windows-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/lxorb/orden/releases/download/v$version/Orden-$version-windows-arm64-setup.exe#/dl.7z"
            }
        }
    }
}
