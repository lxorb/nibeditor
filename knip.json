{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "spike/**",
    "apps/desktop/src-tauri/src/web_state/scripts/*.js",
    "apps/desktop/src-tauri/src/web_tabs/*.js",
    "apps/desktop/src-tauri/src/web_swipe.js"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js,mjs}"],
      "ignoreDependencies": ["vite"]
    },
    "packages/bases": {},
    "packages/editor": {},
    "packages/glasses": {},
    "packages/markdown": {},
    "packages/online": {},
    "packages/rooms": {},
    "packages/sync-core": {},
    "apps/desktop": {
      "entry": [
        "src/**/*.svelte",
        "index.html",
        "even.html",
        "src/even.ts",
        "presenter.html",
        "src/presenter.ts",
        "quick-add.html",
        "src/quick-add.ts",
        "src/site/site.ts",
        "src/lib/ai/review/index.ts"
      ],
      "ignoreDependencies": ["katex", "axe-core"]
    },
    "apps/cli": {
      "ignoreBinaries": ["screencapture"]
    },
    "apps/clipper": {
      "entry": [
        "src/**/*.svelte",
        "src/popup/main.ts",
        "src/options/main.ts",
        "src/background/index.ts",
        "src/content/index.ts",
        "vite.content.config.ts"
      ],
      "ignoreDependencies": ["@nib/themes"]
    },
    "services/sync": {},
    "services/machine": {
      "entry": ["src/main.ts", "vitest.image.config.ts", "test/**/*.drive.ts"]
    },
    "packages/themes": {}
  }
}
