{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "nibeditor",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": true,
        "transparent": true,
        "dragDropEnabled": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": [
        { "schemes": ["nib"] },
        { "name": "Web site URL", "schemes": ["http", "https"], "role": "Viewer" }
      ]
    }
  },
  "bundle": {
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.3"
    }
  }
}
