<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>nibeditor uses the microphone while you record or dictate.</string>
	<key>NSCameraUsageDescription</key>
	<string>nibeditor uses the camera when you take a photo into a note.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>nibeditor turns what you say into words in your note while you dictate.</string>
	<!-- A picture held down in a note offers to go into Photos, and asking without
	     a sentence for it ends the app. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>nibeditor saves a picture from a note to your photos when you ask it to.</string>
	<!-- The notes, and whatever was exported, in the Files app under On My iPhone:
	     plain files somebody can open anywhere, as they are on a desktop in
	     Documents/Nib. Without these the documents folder is the app's alone, and an
	     export went somewhere nobody could reach it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- An app built against the iOS 27 SDK that does not use scenes is stopped by
	     UIKit as it launches. tao takes the scene road only when multiple scenes are
	     on, so they are, and a scene the system asks for beyond the first is
	     answered in lib.rs. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
</dict>
</plist>
