<?xml version="1.0" encoding="utf-8"?>
<!-- nibeditor among the browsers, for an install from the MSI: the values the app
     writes for itself and the NSIS installer writes (src/default_browser.rs holds this
     file to them), in the installing person's own hive, where Default apps reads them,
     and taken away again when the MSI is uninstalled.

     WiX reads this file as it is, so the product's name is written out: it is
     `productName` in tauri.conf.json, and the test holds the two together. The
     program is the file Tauri's own template calls `Path`. The ProgID is NibURL under
     any name, because the choice Windows sealed under Default apps names the ProgID.

     And the folder an install under the old name, Nib, was in. `upgradeCode` in
     tauri.conf.json is that install's, so this MSI replaces it rather than standing
     beside it, but the template looks for the folder under the current name only: an
     update keeps the folder it had, where a pinned taskbar icon and an agent's MCP
     entry find the program. Searched the way the template searches, the NSIS
     installer's key first and the MSI's own last, since the last one found wins. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="NIB_OLD_INSTALLDIR">
      <RegistrySearch Id="NibOldInstallDirNsis" Root="HKCU" Key="Software\Emil Vinu\Nib" Type="raw" />
      <RegistrySearch Id="NibOldInstallDirMsi" Root="HKCU" Key="Software\Emil Vinu\Nib" Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDIR" Value="[NIB_OLD_INSTALLDIR]" After="AppSearch" Sequence="both">NIB_OLD_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed</SetProperty>

    <!-- The old install's shortcuts. The template keeps an upgraded product's
         shortcuts on purpose (RemoveShortcuts is skipped while one is replaced), so
         that they survive an update under the same name; under a new one they would
         stand beside the new shortcuts, starting the same program. -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Directory Id="NibOldProgramsFolder" Name="Nib" />
    </DirectoryRef>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NibOldShortcuts" Guid="{D41EA00E-B36C-46E1-8F73-33B16D88B785}">
        <RemoveFile Id="NibOldStartMenu" Directory="NibOldProgramsFolder" Name="Nib.lnk" On="install" />
        <RemoveFolder Id="NibOldProgramsFolder" Directory="NibOldProgramsFolder" On="install" />
        <RemoveFile Id="NibOldDesktop" Directory="DesktopFolder" Name="Nib.lnk" On="install" />
        <RemoveFile Id="NibOldUninstall" Directory="INSTALLDIR" Name="Uninstall Nib.lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\Emil Vinu\nibeditor" Name="Old Shortcuts Removed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NibBrowser" Guid="{430E18E2-2AB0-4CA7-8815-450321C11811}">
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor" Type="string" Value="nibeditor" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\shell\open\command" Type="string" Value="&quot;[!Path]&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities" Name="ApplicationName" Type="string" Value="nibeditor" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities" Name="ApplicationDescription" Type="string" Value="Notes and the web in one window." />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities\Startmenu" Name="StartMenuInternet" Type="string" Value="nibeditor" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities\URLAssociations" Name="http" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\nibeditor\Capabilities\URLAssociations" Name="https" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL" Type="string" Value="nibeditor URL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationName" Type="string" Value="nibeditor" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\shell\open\command" Type="string" Value="&quot;[!Path]&quot; --url &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="nibeditor" Type="string" Value="Software\Clients\StartMenuInternet\nibeditor\Capabilities" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
