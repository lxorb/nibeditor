<?xml version="1.0" encoding="utf-8"?>
<!-- Orden among the browsers, for an install from the MSI: the values the app writes
     for itself and the NSIS installer writes (src/default_browser.rs holds this file
     to them), in the installing person's own hive, where Default apps reads them, and
     taken away again when the MSI is uninstalled.

     WiX reads this file as it is, so the product's name is written out: it is
     `productName` in tauri.conf.json, and the test holds the two together. The
     program is the file Tauri's own template calls `Path`. The ProgID is NibURL under
     any name, because the choice Windows sealed under Default apps names the ProgID.

     And the folder an install under an old name, Nib until 0.11 or nibeditor from 0.12
     to 0.13, was in. `upgradeCode` in tauri.conf.json is the one all three MSIs share,
     so this MSI replaces the one there is rather than standing beside it, but the
     template looks for the folder under the current name only: an update keeps the
     folder it had, where a pinned taskbar icon and an agent's MCP entry find the
     program. Searched the way the template searches, the NSIS installer's key first
     and the MSI's own last, the older name before the later one, since the last one
     found wins: an install of Nib that 0.12 updated is remembered under nibeditor. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="NIB_OLD_INSTALLDIR">
      <RegistrySearch Id="NibOldInstallDirNsis" Root="HKCU" Key="Software\Emil Vinu\Nib" Type="raw" />
      <RegistrySearch Id="NibOldInstallDirMsi" Root="HKCU" Key="Software\Emil Vinu\Nib" Name="InstallDir" Type="raw" />
      <RegistrySearch Id="NibeditorOldInstallDirNsis" Root="HKCU" Key="Software\Emil Vinu\nibeditor" Type="raw" />
      <RegistrySearch Id="NibeditorOldInstallDirMsi" Root="HKCU" Key="Software\Emil Vinu\nibeditor" Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDIR" Value="[NIB_OLD_INSTALLDIR]" After="AppSearch" Sequence="both">NIB_OLD_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed</SetProperty>

    <!-- The old install's shortcuts, under either old name. The template keeps an
         upgraded product's shortcuts on purpose (RemoveShortcuts is skipped while one
         is replaced), so that they survive an update under the same name; under a new
         one they would stand beside the new shortcuts, starting the same program. -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Directory Id="NibOldProgramsFolder" Name="Nib" />
      <Directory Id="NibeditorOldProgramsFolder" Name="nibeditor" />
    </DirectoryRef>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NibOldShortcuts" Guid="{4F16959F-30B9-469A-ADEA-69951B8B1700}">
        <RemoveFile Id="NibOldStartMenu" Directory="NibOldProgramsFolder" Name="Nib.lnk" On="install" />
        <RemoveFolder Id="NibOldProgramsFolder" Directory="NibOldProgramsFolder" On="install" />
        <RemoveFile Id="NibOldDesktop" Directory="DesktopFolder" Name="Nib.lnk" On="install" />
        <RemoveFile Id="NibOldUninstall" Directory="INSTALLDIR" Name="Uninstall Nib.lnk" On="install" />
        <RemoveFile Id="NibeditorOldStartMenu" Directory="NibeditorOldProgramsFolder" Name="nibeditor.lnk" On="install" />
        <RemoveFolder Id="NibeditorOldProgramsFolder" Directory="NibeditorOldProgramsFolder" On="install" />
        <RemoveFile Id="NibeditorOldDesktop" Directory="DesktopFolder" Name="nibeditor.lnk" On="install" />
        <RemoveFile Id="NibeditorOldUninstall" Directory="INSTALLDIR" Name="Uninstall nibeditor.lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\Emil Vinu\Orden" Name="Old Shortcuts Removed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NibBrowser" Guid="{12BF5322-2EF3-4BA7-BB07-FC2F700B49CB}">
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden" Type="string" Value="Orden" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\shell\open\command" Type="string" Value="&quot;[!Path]&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationName" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationDescription" Type="string" Value="Notes and the web in one window." />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\Startmenu" Name="StartMenuInternet" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\URLAssociations" Name="http" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\URLAssociations" Name="https" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL" Type="string" Value="Orden URL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationName" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\shell\open\command" Type="string" Value="&quot;[!Path]&quot; --url &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Orden" Type="string" Value="Software\Clients\StartMenuInternet\Orden\Capabilities" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
