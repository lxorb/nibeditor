<?xml version="1.0" encoding="utf-8"?>
<!-- Nib among the browsers, for an install from the MSI: the values the app writes
     for itself and the NSIS installer writes (src/default_browser.rs holds this file
     to them), in the installing person's own hive, where Default apps reads them, and
     taken away again when the MSI is uninstalled.

     A template Tauri renders before WiX reads it, so the product's name is its own
     `product_name` and the program is the file the main template calls `Path`. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NibBrowser" Guid="{325FDB6B-186F-426A-99A8-EA80EC722D97}">
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}" Type="string" Value="{{product_name}}" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\shell\open\command" Type="string" Value="&quot;[!Path]&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities" Name="ApplicationName" Type="string" Value="{{product_name}}" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities" Name="ApplicationDescription" Type="string" Value="Notes and the web in one window." />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities\Startmenu" Name="StartMenuInternet" Type="string" Value="{{product_name}}" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities\URLAssociations" Name="http" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities\URLAssociations" Name="https" Type="string" Value="NibURL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL" Type="string" Value="{{product_name}} URL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationName" Type="string" Value="{{product_name}}" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\Application" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\NibURL\shell\open\command" Type="string" Value="&quot;[!Path]&quot; --url &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="{{product_name}}" Type="string" Value="Software\Clients\StartMenuInternet\{{product_name}}\Capabilities" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
