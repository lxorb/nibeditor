{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orden",
  "version": "0.15.0",
  "identifier": "ch.emilvinu.nib",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orden",
        "width": 1180,
        "height": 760,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-iR2Aqj1jRJSx35wTBtrVLSatm9gSp55tpjHpCB3GAHs=' 'sha256-v841QeTG55+uEpzDrS3ofxcdk/VIgYtt2NynJyqxXik='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' data: blob: https: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' https: wss: ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:* ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nib"] },
      "mobile": [{ "scheme": ["nib"], "appLink": false }]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQUM4NjVBMDQ2QTcxMTAKUldRUWNXb0VXb2FzTDQyVlJYWmxKdkFvMXc5MERZeVVOTmttMExMSFlEbW9lMlA0OUY5R3M5ZW8K",
      "endpoints": ["https://github.com/lxorb/orden/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "publisher": "Emil Vinu",
    "homepage": "https://orden.so",
    "shortDescription": "Markdown editor with live preview",
    "longDescription": "Orden is a small markdown editor that formats what you write as you write it. There is no split screen and no preview pane: headings, emphasis, lists, tables, code and math take their final shape in the same window you type in, and the markdown underneath stays plain text you can open anywhere.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      },
      "wix": {
        "upgradeCode": "d5bab44c-df33-5303-bd5d-b6449f670c8e",
        "fragmentPaths": ["wix/browser.wxs", "wix/pdf.wxs"],
        "componentRefs": ["NibBrowser", "NibOldShortcuts", "NibPdf"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.40.0)",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": ["gstreamer1.0-libav", "gstreamer1.0-plugins-bad"],
        "conflicts": ["nib", "nibeditor"],
        "replaces": ["nib", "nibeditor"],
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "obsoletes": ["nib", "nibeditor"],
        "desktopTemplate": "linux/main.desktop"
      }
    },
    "iOS": {
      "minimumSystemVersion": "16.4"
    }
  }
}
