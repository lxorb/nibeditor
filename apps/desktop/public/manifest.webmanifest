{
  "name": "nibeditor",
  "short_name": "nibeditor",
  "description": "A markdown editor. Nothing but markdown.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1013",
  "theme_color": "#0e1013",
  "categories": ["productivity"],
  "protocol_handlers": [{ "protocol": "web+nib", "url": "/?nib=%s" }],
  "icons": [
    { "src": "/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
