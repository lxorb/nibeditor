{
  "proves": "a password field refuses browser_type, its value is in no snapshot and no read (not even as bullets, which say how long it is), and signing in is a takeover",
  "doc": "9.4, 7.3",
  "steps": [
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/signin"
      },
      "save": {
        "tab": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{tab}",
        "for": "load"
      }
    },
    {
      "call": "browser_find",
      "args": {
        "tab": "{tab}",
        "role": "textbox",
        "name": "Password"
      },
      "expect": {
        "status": "ok",
        "has": ["result.matches.0.ref"]
      },
      "save": {
        "password": "result.matches.0.ref"
      }
    },
    {
      "call": "browser_type",
      "args": {
        "tab": "{tab}",
        "ref": "{password}",
        "text": "guessed"
      },
      "expect": {
        "status": "error",
        "code": "password_field"
      }
    },
    {
      "call": "browser_snapshot",
      "args": {
        "tab": "{tab}"
      },
      "expect": {
        "status": "ok",
        "lacks": {
          "result.text": "hunter2"
        }
      }
    },
    {
      "call": "browser_snapshot",
      "args": {
        "tab": "{tab}"
      },
      "expect": {
        "status": "ok",
        "lacks": {
          "result.text": "•••"
        }
      }
    },
    {
      "call": "browser_read",
      "args": {
        "tab": "{tab}",
        "as": "text"
      },
      "expect": {
        "status": "ok",
        "lacks": {
          "result.text": "hunter2"
        }
      }
    },
    {
      "call": "browser_find",
      "args": {
        "tab": "{tab}",
        "role": "button",
        "name": "Sign in"
      },
      "expect": {
        "status": "ok",
        "has": ["result.matches.0.ref"]
      },
      "save": {
        "go": "result.matches.0.ref"
      }
    },
    {
      "call": "browser_click",
      "args": {
        "tab": "{tab}",
        "ref": "{go}"
      },
      "expect": {
        "one_of": [
          {
            "status": "needs_approval"
          },
          {
            "status": "error",
            "code": "password_field"
          }
        ]
      }
    },
    {
      "record": "signin",
      "count": 0
    }
  ],
  "known": "agent-core: a snapshot carries a password field's bullets, one a character, which is its length (9.4 says its value is nothing)"
}
