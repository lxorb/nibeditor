{
  "proves": "a picker the page opens itself on an agent's ordinary press (showPicker on a button) puts no engine window on any screen, and where the engine put it is reported",
  "doc": "6.5",
  "idle": 60,
  "steps": [
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/pickers"
      },
      "save": {
        "tab": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{tab}",
        "for": "load"
      }
    },
    {
      "call": "browser_find",
      "args": {
        "tab": "{tab}",
        "role": "button",
        "name": "Pick a day"
      },
      "expect": {
        "status": "ok",
        "has": ["result.matches.0.ref"]
      },
      "save": {
        "pick": "result.matches.0.ref"
      }
    },
    {
      "call": "browser_click",
      "args": {
        "tab": "{tab}",
        "ref": "{pick}"
      }
    },
    {
      "windows": 1500
    },
    {
      "record": "pick",
      "where": {
        "opened": true
      },
      "count": 1
    },
    {
      "call": "browser_press",
      "args": {
        "tab": "{tab}",
        "keys": "Escape"
      }
    },
    {
      "keyboard": "unchanged"
    }
  ]
}
