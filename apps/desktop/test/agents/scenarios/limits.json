{
  "proves": "an agent over its tabs parks the one used longest ago, and over its navigations a minute is held back until the minute has room, or the stop",
  "doc": "6.4, 9.5",
  "grant": {
    "limits": {
      "tabs": 2,
      "calls": 600,
      "navigations": 3
    }
  },
  "steps": [
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/keys"
      },
      "save": {
        "first": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{first}",
        "for": "load"
      }
    },
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/shop"
      },
      "save": {
        "second": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{second}",
        "for": "load"
      }
    },
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/mail"
      },
      "save": {
        "third": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{third}",
        "for": "load"
      }
    },
    {
      "call": "browser_tabs",
      "args": {},
      "expect": {
        "status": "ok",
        "contains": {
          "result.agent": "\"parked\": true"
        }
      }
    },
    {
      "call": "browser_navigate",
      "args": {
        "tab": "{third}",
        "url": "{site}/keys"
      }
    },
    {
      "call": "browser_navigate",
      "args": {
        "tab": "{third}",
        "url": "{site}/shop"
      }
    },
    {
      "call": "browser_navigate",
      "args": {
        "tab": "{third}",
        "url": "{site}/mail"
      }
    },
    {
      "call": "browser_navigate",
      "args": {
        "tab": "{third}",
        "url": "{site}/keys"
      },
      "as": "held"
    },
    {
      "pause": 1500
    },
    {
      "reader": "agents_stop"
    },
    {
      "join": "held",
      "expect": {
        "status": "error",
        "code": "stopped",
        "slower_than_ms": 1400
      }
    },
    {
      "reader": "agents_resume"
    }
  ]
}
